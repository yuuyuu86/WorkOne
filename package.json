{
  "name": "workone",
  "version": "2.0.0",
  "description": "連絡・学校・予定系サービスをまとめて見るための連絡専用ブラウザー",
  "main": "dist-electron/main.js",
  "author": "WorkOne",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run icons && npm run build:ai && npm run build && electron-builder",
    "dist:dir": "npm run icons && npm run build:ai && npm run build && electron-builder --dir",
    "build:ai": "sh scripts/build-ai.sh",
    "dist:signed": "npm run icons && npm run build:ai && npm run build && electron-builder -c.mac.notarize=true --publish never",
    "release": "npm run icons && npm run build:ai && npm run build && electron-builder -c.mac.notarize=true --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.workone.app",
    "productName": "WorkOne",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "現在地の天気を表示するために位置情報を使用します。",
        "NSLocationUsageDescription": "現在地の天気を表示するために位置情報を使用します。",
        "NSCameraUsageDescription": "ビデオ会議（Google Meet など）でカメラを使用します。",
        "NSMicrophoneUsageDescription": "ビデオ会議（Google Meet など）でマイクを使用します。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yuuyuu86",
        "repo": "WorkOne"
      }
    ]
  }
}
